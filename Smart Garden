<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Smart Garden</title>
  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      background: linear-gradient(135deg, #e0f7fa 0%, #b2ebf2 50%, #e0f2f1 100%);
      background-attachment: fixed;
      background-size: cover;
      margin: 0;
      padding: 20px;
      text-align: center;
      min-height: 100vh;
    }
    h1 {
      color: #00695c;
      margin-bottom: 20px;
    }
    .card {
      background: #ffffff;
      padding: 30px;
      margin: 20px auto;
      width: 90%;
      max-width: 420px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
      border-radius: 20px;
      text-align: left;
      transition: transform 0.3s ease;
    }
    .card:hover {
      transform: translateY(-5px);
    }
    .status {
      font-size: 18px;
      margin: 12px 0;
      display: flex;
      align-items: center;
    }
    .status span {
      margin-left: 10px;
    }
    .buttons {
      margin-top: 20px;
      text-align: center;
    }
    .btn {
      display: inline-block;
      padding: 10px 20px;
      margin: 8px;
      border: none;
      border-radius: 30px;
      color: #fff;
      font-size: 16px;
      cursor: pointer;
      transition: background 0.3s, transform 0.2s;
    }
    .btn:hover {
      transform: scale(1.05);
    }
    .btn-mode { background: #00796b; }
    .btn-mode:hover { background: #004d40; }

    .btn-pump { background: #039be5; }
    .btn-pump:hover { background: #0277bd; }

    .btn-light { background: #fbc02d; color: #333; }
    .btn-light:hover { background: #f9a825; }
  </style>
</head>
<body>
  <h1>🌿 Smart Garden 🌿</h1>
  <div class="card">
    <div class="status">🌡️<span>Nhiệt độ: Đang tải...</span></div>
    <div class="status">💧<span>Độ ẩm không khí: Đang tải...</span></div>
    <div class="status">🌱<span>Độ ẩm đất: Đang tải...</span></div>
    <div class="status">☀️<span>Ánh sáng: Đang tải...</span></div>
    <div class="status">🌧️<span>Mưa: Đang tải...</span></div>
    <div class="status">🔄<span>Chế độ: Đang tải...</span></div>
    <div class="status">💡<span>Đèn: Đang tải...</span></div>
    <div class="status">🚿<span>Máy bơm: Đang tải...</span></div>

    <div class="buttons">
      <button class="btn btn-mode">🔄 Chuyển chế độ</button>
      <button class="btn btn-pump">🚿 Bật/Tắt Bơm</button>
      <button class="btn btn-light">💡 Bật/Tắt Đèn</button>
    </div>
  </div>

  <script>
    // Hàm cập nhật giao diện
    function updateUI(data) {
      document.querySelector('.status:nth-child(1) span').textContent = `Nhiệt độ: ${data.temperature}°C`;
      document.querySelector('.status:nth-child(2) span').textContent = `Độ ẩm không khí: ${data.humidity}%`;
      document.querySelector('.status:nth-child(3) span').textContent = `Độ ẩm đất: ${data.soilMoisture} (${data.soilMoisture < 500 ? 'Khô' : 'Đủ ẩm'})`;
      document.querySelector('.status:nth-child(4) span').textContent = `Ánh sáng: ${data.light}`;
      document.querySelector('.status:nth-child(5) span').textContent = `Mưa: ${data.rain ? 'Có mưa' : 'Không mưa'}`;
      document.querySelector('.status:nth-child(6) span').textContent = `Chế độ: ${data.mode === 'auto' ? 'Tự động' : 'Thủ công'}`;
      document.querySelector('.status:nth-child(7) span').textContent = `Đèn: ${data.lightOn ? 'BẬT' : 'TẮT'}`;
      document.querySelector('.status:nth-child(8) span').textContent = `Máy bơm: ${data.pumpOn ? 'BẬT' : 'TẮT'}`;
    }

    // Hàm lấy dữ liệu cảm biến
    async function fetchSensorData() {
      try {
        const response = await fetch('/api/sensors');
        if (!response.ok) throw new Error('Lỗi kết nối');
        const data = await response.json();
        updateUI(data);
      } catch (error) {
        console.error('Lỗi khi lấy dữ liệu:', error);
        document.querySelectorAll('.status span').forEach(el => {
          el.textContent = 'Lỗi tải dữ liệu';
        });
      }
    }

    // Hàm gửi lệnh điều khiển
    async function sendCommand(device) {
      try {
        const response = await fetch('/api/control', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ device })
        });
        
        if (!response.ok) throw new Error('Lỗi điều khiển');
        const result = await response.json();
        fetchSensorData(); // Cập nhật lại trạng thái sau khi điều khiển
      } catch (error) {
        console.error('Lỗi khi gửi lệnh:', error);
        alert('Lỗi khi thực hiện thao tác!');
      }
    }

    // Gán sự kiện cho các nút
    document.querySelector('.btn-mode').addEventListener('click', () => sendCommand('mode'));
    document.querySelector('.btn-pump').addEventListener('click', () => sendCommand('pump'));
    document.querySelector('.btn-light').addEventListener('click', () => sendCommand('light'));

    // Tự động cập nhật dữ liệu mỗi 3 giây
    setInterval(fetchSensorData, 3000);
    fetchSensorData(); // Lấy dữ liệu ngay khi tải trang
  </script>
</body>
</html>
// Giả lập dữ liệu cảm biến (có thể kết nối với IoT thực tế)
export default function handler(req, res) {
  const sensorData = {
    temperature: Math.floor(Math.random() * 10) + 25, // 25-35°C
    humidity: Math.floor(Math.random() * 20) + 60,   // 60-80%
    soilMoisture: Math.floor(Math.random() * 300) + 400, // 400-700
    light: Math.random() > 0.5 ? "Sáng" : "Tối",
    rain: Math.random() > 0.8,
    mode: Math.random() > 0.5 ? "auto" : "manual",
    lightOn: Math.random() > 0.5,
    pumpOn: Math.random() > 0.5
  };
  res.status(200).json(sensorData);
}
// Xử lý lệnh điều khiển từ frontend
export default function handler(req, res) {
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  const { device } = req.body;
  
  // Giả lập điều khiển thành công
  // Trong thực tế: Gửi lệnh đến thiết bị IoT qua MQTT/HTTP
  console.log(`Đã nhận lệnh điều khiển: ${device}`);
  
  res.status(200).json({ 
    message: `Đã thực hiện ${device}`,
    device
  });
}
